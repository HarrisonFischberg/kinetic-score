{
  "name": "kinetic-score",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Kinetic Score \u2014 a browser audiovisual playground and video studio: ball physics, geometric sound generators, a Shepard-tone lab and kinetic machines performing public-domain classical excerpts.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "build:static": "node scripts/build-static.ts",
    "serve:static": "node scripts/serve.ts",
    "scores": "node scripts/build-scores.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "@types/node": "^22.18.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}