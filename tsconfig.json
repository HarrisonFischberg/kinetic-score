{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "typeRoots": [
      "./vendor/types",
      "./node_modules/@types"
    ],
    "types": [
      "webxr"
    ],
    "paths": {
      "three": [
        "./vendor/types/three/index.d.ts"
      ]
    },
    "outDir": "build/static-tsc",
    "sourceMap": false
  },
  "include": [
    "src"
  ]
}